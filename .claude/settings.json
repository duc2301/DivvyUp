{
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npm run build:*)",
      "Bash(npx tsc --noEmit)",
      "Bash(npm run release:plan:*)",
      "Bash(node scripts/sonar/fetch-report.mjs:*)",
      "Bash(node .claude/skills/agent-framework/kiem-agent.mjs:*)"
    ],
    "deny": [
      "Bash(eas build:*)",
      "Bash(xcodebuild:*)",
      "Bash(./gradlew:*)",
      "Bash(gradlew:*)",
      "Bash(npx expo prebuild:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./web/.env)",
      "Read(./web/.env.local)",
      "Read(./.env.secrets)",
      "Read(./web/.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/chan-lenh-nguy-hiem.mjs\""
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/nhac-soat-bat-bien.mjs\""
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/nhac-push-main.mjs\""
          }
        ]
      }
    ]
  }
}

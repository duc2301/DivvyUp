{
  "expo": {
    "name": "DivvyUp",
    "slug": "DivvyUp",
    "version": "1.0.1",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/185f818f-35fb-4817-912a-cf5df34862d7"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "divvyup",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.ducccc.DivvyUp",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ducccc.DivvyUp",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#FFFFFF",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "DivvyUp cần truy cập ảnh để bạn chọn ảnh đại diện và ảnh mã QR nhận tiền.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "185f818f-35fb-4817-912a-cf5df34862d7"
      }
    },
    "owner": "ducccc"
  }
}
